rules_version = '2';

/**
 * ==============================================================================
 * FIRESTORE SECURITY RULES - ASHTATIC INTERNET SOLUTION
 * Project ID   : ashetic-93d32
 * Storage Bucket: ashetic-93d32.firebasestorage.app
 * Terakhir Diperbarui : 22 November 2026 (Fitur Lapor Gangguan Jaringan)
 * ==============================================================================
 * Aturan keamanan Cloud Firestore untuk:
 * 1. Pendaftaran Pasang Baru (Formulir Publik)
 * 2. Lacak Status Tiket & Cari via Nomor HP (Tracking Publik)
 * 3. Pengaturan Nama WiFi (SSID) & Kata Sandi (Password) oleh Pelanggan
 * 4. Pemantauan & Blokir Perangkat Pengguna WiFi (wifiDevices) via ID Langganan
 * 5. Input & Pengelolaan Daftar Pengguna WiFi Pelanggan oleh Admin
 * 6. Lapor Gangguan Jaringan (Kendala Internet, Lemot, Putus, Ganti Sandi)
 * 7. Pengelolaan Status Laporan & Penugasan Teknisi oleh Admin
 * 8. Hapus Data Permanen dari Database oleh Admin
 *
 * CARA MEMASANG RULES INI DI FIREBASE CONSOLE:
 * 1. Buka https://console.firebase.google.com/
 * 2. Masuk ke project "ashetic-93d32"
 * 3. Di menu sebelah kiri, klik "Firestore Database"
 * 4. Klik tab "Rules" di bagian atas
 * 5. Hapus rules yang lama, lalu Paste seluruh isi kode ini
 * 6. Klik tombol "Publish" (Publikasikan)
 * ==============================================================================
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================================
    // 1. KOLEKSI: registrations (Data Pendaftaran, Tracking, & Router WiFi)
    // ==========================================================================
    match /registrations/{ticketId} {

      // A. CREATE (Pendaftaran Baru dari Pengunjung):
      allow create: if request.resource.data.keys().hasAll([
                        'ticketId', 'fullName', 'phone', 'email', 'packageId', 
                        'address', 'status', 'createdAt'
                      ])
                      && request.resource.data.fullName is string 
                      && request.resource.data.fullName.size() >= 3
                      && request.resource.data.phone is string 
                      && request.resource.data.phone.size() >= 9
                      && request.resource.data.status in ['menunggu_verifikasi', 'pending'];

      // B. READ (Lacak Status, Cek Pengguna WiFi, & Pencarian Admin):
      allow read: if true;

      // C. UPDATE (Update Status, SSID/Password, & Perangkat Terhubung):
      allow update: if true;

      // D. DELETE (Hapus Permanen):
      allow delete: if true;

      // Sub-koleksi untuk perangkat terhubung jika router melakukan sync terpisah
      match /devices/{deviceId} {
        allow read, write: if true;
      }
    }

    // ==========================================================================
    // 2. KOLEKSI: network_reports (Tiket Laporan Gangguan & Kendala Jaringan)
    // ==========================================================================
    match /network_reports/{reportId} {
      // Pelanggan membuat tiket laporan kendala (mati, ngeleg, ganti wifi, dll)
      allow create: if request.resource.data.keys().hasAll([
                        'reportId', 'subscriptionId', 'category', 'phone', 'createdAt'
                      ]);

      // Pelanggan melacak status laporannya & Admin melihat semua laporan masuk
      allow read: if true;

      // Admin mengupdate status penanganan, teknisi, dan solusi kendala
      allow update: if true;

      // Admin menghapus laporan
      allow delete: if true;
    }

    // ==========================================================================
    // 3. KOLEKSI: stats, settings, & wifi_devices (Pengaturan & Metrik)
    // ==========================================================================
    match /stats/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /wifi_devices/{deviceId} {
      allow read, write: if true;
    }

    // ==========================================================================
    // 4. KOLEKSI LAINNYA: Default ditutup untuk keamanan
    // ==========================================================================
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
